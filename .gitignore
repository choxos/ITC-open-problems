# Technical documentation and audit working files (kept local, not version-controlled
# per project decision)
documentation/

# Quarto render output and caches
/docs/
/_site/
/.quarto/
*_files/
/site_libs/

# Per-file HTML left in the source tree by an interrupted Quarto render
/*.html
/problems/*.html
/categories/*.html

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
*.rds

# Node (site build script)
node_modules/

# Agent guidance files (local only, not part of the published site)
CLAUDE.md
AGENTS.md
.claude/

# Working directories the reading agents extract paper text into. Regenerable
# from the PDFs and large enough to dominate the repository.
/scratch/
/scratchpad/

# Simulation study working files. Raw per-replicate output is regenerable from
# the master seed and large; the tracked artifacts are results/summary.csv,
# results/provenance.md and the rendered manuscripts under out/.
/studies/*/results/raw/
/studies/*/manuscript/manuscript_files/
/studies/*/manuscript/*.md
/studies/*/manuscript/*.pdf
/studies/*/manuscript/*.odt

# OS / editor cruft
.DS_Store
*~
.vscode/
.idea/

**/*.quarto_ipynb
